{
  "name": "batbot-v11-hft",
  "version": "1.0.0",
  "description": "BATBOT_V11 High-Frequency Trading System",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "scripts": {
    "build:rust": "node scripts/build_rust.js",
    "build:ts": "tsc",
    "build:dashboard": "vite build",
    "build": "npm run build:rust && npm run build:ts && npm run build:dashboard",
    "check": "cargo check",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.dashboard.json --noEmit && tsc -p tsconfig.jest.json --noEmit",
    "test": "jest",
    "test:phase9": "tsc && node dist/tests/test_phase9_master_validation.js",
    "test:ws": "tsc && node dist/tests/test_ws_order_client.js",
    "test:ofi": "tsc && node dist/tests/test_multi_level_ofi.js",
    "test:urgency": "tsc && node dist/tests/test_urgency_router.js",
    "test:funding": "tsc && node dist/tests/test_funding_rate_filter.js",
    "test:funding:live": "tsc && node dist/tests/test_live_funding_rate_ingestion.js",
    "test:mhdc": "tsc && node dist/tests/test_mhdc_alpha_expiration.js",
    "start": "npm run start:live",
    "start:live": "npm run build:rust && npm run build:ts && node dist/supervisor/guardian.js",
    "bot:run": "npm run build:rust && npm run build:ts && node dist/supervisor/guardian.js",
    "dev": "vite",
    "trainmodels": "npm run build:ts && node dist/scripts/manual_train.js"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^14.11.1",
    "lucide-react": "^1.71.0",
    "protobufjs": "^8.7.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-virtuoso": "^4.18.11",
    "tailwind-merge": "^3.7.0",
    "uplot": "^1.6.32",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^30.5.2",
    "@napi-rs/cli": "^2.18.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.1.5"
  }
}
