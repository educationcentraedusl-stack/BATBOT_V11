{
  "name": "batbot-v11-hft",
  "version": "1.0.0",
  "description": "BATBOT_V11 High-Frequency Trading System",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "scripts": {
    "build:rust": "napi build --platform --release",
    "build:ts": "tsc",
    "build:dashboard": "vite build",
    "build": "npm run build:rust && npm run build:ts && npm run build:dashboard",
    "check": "cargo check",
    "test": "tsc --noEmit",
    "start": "npm run start:live",
    "start:live": "npm run build:rust && npm run build:ts && node dist/scripts/run_tui_dashboard.js",
    "bot:run": "npm run build:rust && npm run build:ts && node dist/scripts/run_tui_dashboard.js",
    "dev": "vite",
    "trainmodels": "npm run build:ts && node dist/scripts/manual_train.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "protobufjs": "^8.7.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-virtuoso": "^4.18.11",
    "uplot": "^1.6.32",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^6.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
}
