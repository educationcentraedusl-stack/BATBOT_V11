{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "tests/**/*.test.ts",
    "tests/**/*.test.tsx",
    "tests/verify_killswitch_hotswap.ts",
    "src/dashboard/**/*",
    "src/lib/**/*",
    "jest.config.ts"
  ],
  "exclude": [
    "src/dashboard/telemetry.worker.ts"
  ]
}
