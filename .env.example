# ==========================================
# BATBOT_V11 HIGH-FREQUENCY TRADING SYSTEM
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# Trading Environment Toggle
# Set USE_TESTNET=true for Binance Futures Testnet
# Set USE_TESTNET=false for Production Live Trading
USE_TESTNET=true
BINANCE_TESTNET=true

# Binance Futures Testnet API Credentials
# Get keys from: https://testnet.binancefuture.com
BINANCE_TESTNET_API_KEY=your_binance_testnet_api_key_here
BINANCE_TESTNET_SECRET_KEY=your_binance_testnet_secret_key_here

# Binance Futures Production API Credentials
# Used when USE_TESTNET=false
BINANCE_API_KEY=your_binance_live_api_key_here
BINANCE_API_SECRET=your_binance_live_api_secret_here

# Server & Telemetry Network Configuration
PORT=5000
TELEMETRY_PORT=8080
NODE_ENV=production

# High-Frequency Trading & Multi-Asset Symbol Settings
MAX_CONCURRENT_ASSETS=10
SAB_SLOTS_PER_ASSET=256
SYMBOL=BTCUSDT
HIGH_PRIORITY_SYMBOLS=BTCUSDT,ETHUSDT
EXCHANGE=binance
PROFIT_HUNTER_MODE=true

# Fee Drag Mitigation & Maker/Taker Fee Rates
# Maker: 0.018% with BNB fee payment (0.00018) | Taker: 0.045% with BNB fee payment (0.00045)
MAKER_FEE_RATE=0.00018
TAKER_FEE_RATE=0.00045
MIN_NET_ALPHA=0.0015
ENABLE_POST_ONLY_TP=true

# Dynamic Position Sizing & Micro-Ladder Thresholds
# Allocation percentages for 3-stage ladder (e.g. 40,35,25) and 2-stage collapsed ladder (e.g. 60,40)
TP_STAGE_ALLOCATION_3STAGE=40,35,25
TP_STAGE_ALLOCATION_2STAGE=60,40
DYNAMIC_SIZING_CONSOLIDATION_THRESHOLD_USDT=150.0
MIN_NOTIONAL_USDT=10.0
BATCH_ORDER_MAX_LIMIT=5

# User Data Stream WebSocket & Keep-Alive Settings
WEBSOCKET_KEEP_ALIVE_INTERVAL_MS=1800000
WEBSOCKET_RECONNECT_MAX_RETRIES=10
WEBSOCKET_PING_INTERVAL_MS=180000

# Risk Management Parameters
RISK_DAILY_LOSS_CAP=2.0
RISK_MAX_DRAWDOWN=3.0
RISK_CONSECUTIVE_LOSS_HALTS=5
RISK_MAX_OPEN_POSITIONS=10
RISK_PER_TRADE_PCT=60.0
RISK_ATR_LOOKBACK=14
RISK_ATR_MULTIPLIER=0.5
RISK_STALENESS_SEC=20

# Time Synchronization
TIME_SYNC_INTERVAL_MS=30000
RECV_WINDOW_MS=5000
MAX_ALLOWED_DRIFT_MS=20000

# AI Prediction & Confidence Thresholds & VPIN Dynamic Risk Parameters
MIN_AI_CONFIDENCE=0.50
AGGRESSIVE_CONFIDENCE_THRESHOLD=0.85
VPIN_THRESHOLD=0.85
VPIN_BUCKET_VOLUME=50000.0

# Database Configuration (Optional)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/batbot_v11
USE_MEMORY_STORAGE=true
